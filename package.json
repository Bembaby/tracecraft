{
  "name": "tracecraft",
  "version": "0.3.0",
  "private": true,
  "description": "Daily developer practice with real SQL, Python, and an interactive system design lab",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate-accounts.mjs",
    "check": "node scripts/check.mjs",
    "publish:github": "bash scripts/publish-github.sh"
  },
  "dependencies": {
    "@vercel/functions": "3.6.1",
    "better-auth": "1.7.14",
    "pg": "8.23.1"
  }
}
