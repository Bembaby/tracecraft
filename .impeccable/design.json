  "components": [
    {
      "name": "Primary Action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The next step: Continue, Check, Open practice.",
      "html": "<button class=\"ds-primary\">Continue: Work through an example</button>",
      "css": ".ds-primary{font-family:Nunito,'Segoe UI',sans-serif;display:inline-flex;align-items:center;min-height:52px;padding:12px 22px;border:0;border-radius:12px;background:#c4f26d;color:#1d2610;font-weight:850;font-size:16px;box-shadow:inset 0 -3px 0 #8db449,0 6px 14px -8px #05060f;cursor:pointer}.ds-primary:hover{background:#d4ff8a}.ds-primary:active{transform:translateY(2px);box-shadow:inset 0 -1px 0 #8db449}.ds-primary:focus-visible{outline:2px solid #c4f26d;outline-offset:3px}"
    },
