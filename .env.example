# Server configuration only. Never copy these values into browser source.
TRACECRAFT_ORIGIN=http://127.0.0.1:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TRACECRAFT_DB=.tracecraft/progress.sqlite

# Hosted Vercel accounts use Postgres and verified email codes instead.
# Provision DATABASE_URL through the Vercel Marketplace. Keep every secret server-side.
# DATABASE_URL=
# AUTH_URL=https://your-domain.example
# AUTH_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=TraceCraft <signin@mail.your-domain.example>
