      "html": "<button class=\"ds-finish\">Finish lesson</button>",
      "css": ".ds-finish{font-family:Nunito,'Segoe UI',sans-serif;min-height:52px;padding:12px 22px;border:0;border-radius:12px;background:#f4cf78;color:#2b1f05;font-weight:850;font-size:16px;box-shadow:inset 0 -3px 0 #b8933d}"
    },
    {
      "name": "Answer Card",
      "kind": "input",
      "refersTo": "answer-card",
      "description": "A native radio inside a selectable card.",
      "html": "<label class=\"ds-answer\"><input type=\"radio\" name=\"ds-a\"> The first item is replaced by the largest.</label><label class=\"ds-answer\"><input type=\"radio\" name=\"ds-a\" checked> max(values) reads the whole list and return exits.</label>",
      "css": ".ds-answer{font-family:Nunito,'Segoe UI',sans-serif;display:flex;gap:12px;align-items:flex-start;margin:8px 0;padding:14px 16px;border:1px solid #3b3e59;border-radius:14px;background:#202237;color:#f3f1ff;font-weight:650;font-size:16px;cursor:pointer}.ds-answer input{accent-color:#c1aeff;width:18px;height:18px;margin-top:3px}.ds-answer:has(input:checked){border-color:#c1aeff;background:#2c2747;box-shadow:inset 0 -3px 0 #1f1a33}"
    },
    {
      "name": "Stage Map",
      "kind": "nav",
      "refersTo": "stage-node",
      "description": "Lesson map: numbered nodes colored by stage kind; current node is solid.",
      "html": "<ol class=\"ds-map\"><li><button><span class=\"n\" style=\"--q:#a0d4ff;--g:#293f59\">1</span>Build the idea<small>Seen</small></button></li><li><button aria-current=\"step\"><span class=\"n cur\" style=\"--q:#ffc08e;--g:#4c382c\">2</span>Work through an example<small>Now</small></button></li><li><button><span class=\"n\" style=\"--q:#c1aeff;--g:#43355b\">3</span>Check one idea<small></small></button></li></ol>",
      "css": ".ds-map{font-family:Nunito,'Segoe UI',sans-serif;list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:4px;max-width:300px}.ds-map button{display:grid;grid-template-columns:34px 1fr auto;gap:12px;align-items:center;width:100%;min-height:46px;padding:6px 10px 6px 6px;border:1px solid transparent;border-radius:12px;background:transparent;color:#c3c2dc;font:700 14px Nunito,sans-serif;text-align:left}.ds-map button[aria-current]{background:#26283f;border-color:#3f4263;color:#f3f1ff}.ds-map .n{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:var(--g);color:var(--q);font-weight:900;box-shadow:inset 0 -3px 0 #0b0c1a55}.ds-map .n.cur{background:var(--q);color:#17181f}.ds-map small{font-size:12px;font-weight:800;color:#8f90b4}"
    },
    {
      "name": "Heads-up Display",
      "kind": "custom",
      "refersTo": "hud",
      "description": "Level, XP toward the next level, and the practice streak.",
      "html": "<a class=\"ds-hud\" href=\"#\"><span class=\"lv\">Lv <b>2</b></span><span class=\"meter\"><span style=\"width:33%\"></span></span><span><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" style=\"color:#f4cf78;fill:#f4cf78\"><path d=\"m12 3 2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 16.8l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8L12 3Z\"/></svg> <b>80</b> XP</span><span class=\"st\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\"><path d=\"M12 22c4 0 7-2.8 7-6.8 0-3.1-1.8-5.3-3.4-7.1-.4 1.6-1.3 2.7-2.4 3.2.3-3.3-1-6.4-3.7-8.3.2 3-1.5 5-3.2 7C4.9 11.6 5 13.3 5 15.2 5 19.2 8 22 12 22Z\"/></svg> <b>3</b></span></a>",
      "css": ".ds-icon{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-hud{font-family:Nunito,'Segoe UI',sans-serif;display:inline-flex;align-items:center;gap:10px;min-height:36px;padding:4px 12px 4px 5px;border:1px solid #363955;border-radius:999px;background:#1d1f33;color:#f3f1ff;font-size:13px;font-weight:700;text-decoration:none}.ds-hud>span{display:inline-flex;align-items:center;gap:4px}.ds-hud .lv{padding:3px 10px;border-radius:999px;background:#c1aeff;color:#21182e;font-weight:850}.ds-hud .meter{width:72px;height:8px;border-radius:99px;background:#2e3150;overflow:hidden}.ds-hud .meter span{display:block;height:100%;background:#c4f26d}.ds-hud .st{color:#ffc08e}"
    },
    {
      "name": "Code Well",
      "kind": "card",
      "refersTo": "code-well",
      "description": "Recessed monospace example.",
      "html": "<pre class=\"ds-well\">def summary(values):\n    if values is None:\n        return \"missing\"\n    return max(values)</pre>",
      "css": ".ds-well{margin:0;padding:16px 18px;border:1px solid #2c2e4a;border-radius:14px;background:#10111f;color:#ebe8ff;font:15px/1.75 ui-monospace,Consolas,monospace;box-shadow:inset 0 2px 0 #0a0b16;white-space:pre}"
